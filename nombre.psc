Algoritmo nombre
	definir edad Como Real
	definir name Como caracter
	Escribir "Digite su nombre"
	leer name
	Escribir "Digite su edad"
	leer edad
	Si  edad >=18 Entonces
		escribir "su nombre es ", name " y usted es mayor de edad"
	SiNo
		escribir "su nombre es ", name " y usted es menor de edad"
	Fin Si
FinAlgoritmo
