Algoritmo mayorque
	definir a,b Como Real
	Escribir "Digite el primer numero"
	leer a
	Escribir "Digite el segundo numero"
	leer b
	Si  a >= b Entonces
		si a == b Entonces
			escribir a, " es igual a " b
		SiNo
			escribir a, " es mayor que ", b
		FinSi
	SiNo 
		escribir b, " es mayor que ", a
	Fin Si
FinAlgoritmo